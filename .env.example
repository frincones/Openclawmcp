# Variables de entorno del puente MCP -> OpenClaw.
# Estos valores VIVEN EN RAILWAY (Service > Variables), no en el repo.
# Copia este archivo a .env SOLO para correr local; nunca subas el .env real.

# --- OpenClaw (la app en Railway) ---
OPENCLAW_URL=https://openclaw-production-xxxx.up.railway.app
OPENCLAW_ACCESS_KEY=          # cookie sc_auth / bearer de OpenClaw
OPENCLAW_AGENT_ID=default     # id del agente por defecto

# --- El Cuartel (backlog personal) ---
CUARTEL_URL=https://cuartel-xxxx.up.railway.app
CUARTEL_TOKEN=               # token del API del Cuartel

# --- Composio (integraciones: Gmail, Outlook, etc.) ---
COMPOSIO_API_KEY=            # ak_... de Composio

# --- Marketplace de equipos (wizard) ---
MARKETPLACE_URL=https://tdx-marketplace-production.up.railway.app

# --- Infra ---
PORT=8080
PUBLIC_URL=https://mcp-bridge-production-xxxx.up.railway.app   # URL publica de ESTE puente (para los links del QR)
